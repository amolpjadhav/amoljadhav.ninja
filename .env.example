# Supabase — Settings > API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to the client. Required for
# writes from API routes (contact form) and for the Medium migration script.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — used by /api/contact for email notifications (not yet wired up)
RESEND_API_KEY=
CONTACT_EMAIL=

# NYT Books API — powers the Bestsellers tab in Book Finder (server-side only)
NYT_BOOKS_API_KEY=

# YouTube Data API v3 - powers the podcast trending utility (server-side only)
YOUTUBE_API_KEY=
